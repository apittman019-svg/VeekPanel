{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VeekPanel",
  "version": "0.1.0",
  "identifier": "org.veekpanel.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "VeekPanel",
        "width": 1200,
        "height": 850,
        "minWidth": 850,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "VeekPanel",
    "copyright": "Copyright (c) 2026 VeekPanel contributors",
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
